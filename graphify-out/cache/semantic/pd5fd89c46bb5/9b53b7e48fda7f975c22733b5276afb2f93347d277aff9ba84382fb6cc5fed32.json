{"nodes": [{"id": "docs_run_statistics_secret_attribution", "label": "Personal Secret Attribution", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit personal measurement wins, then verified self-report, then a valid API delta. A party delta is never attributed to self and personal counts are never inferred from arbitrary chat or adjacent tab rows; unknown counts display a question mark instead of zero."}, {"id": "docs_run_statistics_score_authority", "label": "Server Score Authority", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server Score takes precedence over estimates and the final Team Score is authoritative over later ordinary Score fields. Footer secrets mean found minus remaining for 300, which is planning guidance, so reaching zero remaining secrets alone does not mean the score reached 300."}, {"id": "docs_run_statistics_puzzle_penalty", "label": "Unfinished Puzzle Penalty", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each unfinished puzzle subtracts 10 skill points separately from its missing share of the room points; the former fixed 14-point deduction was not a separate puzzle penalty. A red map cross parses as CLEARED, so that state alone cannot prove a solved puzzle."}, {"id": "docs_run_statistics_bonus_flags", "label": "Mimic, Prince and Bat Bonus Flags", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global bonus evidence does not identify a contributor, so P/M/B is appended only for explicit named claims or an observed Mimic damage source. A bonus received only by a teammate still needs their report and cannot be inferred from a Prince room or an ordinary entity death."}, {"id": "docs_run_statistics_skyblocker_bridge", "label": "Optional Skyblocker Kill-Callback Bridge", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skyblocker Secret Sync delivered Mimic and Prince kills with no chat report, losing three bonus points. An optional mixin observes the accepted callbacks after Skyblocker validates the sender, setting existing per-run flags without polling another mod's state, opening a connection or guessing a contributor."}, {"id": "docs_run_statistics_summary_roster", "label": "Dungeon Summary Roster", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The roster admits only self and identified dungeon class rows, at most five; global party history and general online-player caches never supply participants. UUID remapping preserves one canonical row and instance reset clears membership while countdown and result display retain it."}, {"id": "docs_run_statistics_splits_personal_best", "label": "Split Personal Bests", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PBs are independent per-phase records across runs, not the phases of one fastest run, and normal and master floors never share records. Candidates are collected at boundaries and committed in one batched save at finish so late M7 metadata can still classify the early phases correctly."}, {"id": "docs_run_statistics_splits_avg_history", "label": "Recent Runs AVG History", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Up to the last 20 confirmed finished runs per floor and mode are stored oldest first, with each phase baseline the arithmetic mean across them. Missing or zero phases are omitted from the denominator rather than treated as zero, and there is no PB fallback or cross-floor sharing."}, {"id": "docs_run_statistics_time_prediction", "label": "Split Time Prediction", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase End uses real elapsed time at the last boundary plus baselines of the active and later phases and stays fixed within a phase, while Live uses current Run time plus only later baselines. Future sums are cached at boundaries so AVG does not scan history every frame."}, {"id": "docs_run_statistics_standalone_ping_tick_source", "label": "Standalone Ping Tick Source", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only standalone non-zero ping packets count as game ticks; additional pings inside a ClientboundBundlePacket are synchronization traffic and are ignored before deduplication. Several standalone packets at one instant remain several ticks, and no ticks are inferred from ID gaps."}, {"id": "docs_run_statistics_time_lost", "label": "Time Lost Measurement", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ideal duration conserves 50 ms per accepted standalone tick and ticks are never clipped to real time, because receipt jitter would otherwise discard valid progress. Total loss is total real time minus total accepted tick time, not the sum of positive phase losses."}, {"id": "docs_run_statistics_mort_start_rebase", "label": "Mort Greeting Timer Rebase", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mort's exact map greeting rebases real and accepted-tick time once before Blood Open completes, excluding observed pre-start countdown time rather than applying a fixed one-second deduction. Missing greetings retain the countdown fallback and late or duplicate greetings cannot reset timings."}, {"id": "docs_run_statistics_run_end_chat", "label": "Run End Chat Summary", "file_type": "concept", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_run_statistics_allow_game_message_routing", "label": "ALLOW_GAME Message Routing", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The router previously used post-filter GAME and CHAT events, so only Kung's own filter forwarded hidden messages and a cancelled Prince report could be lost. It now observes the original message once via ALLOW_GAME and ALLOW_CHAT, and the old forwarding path was removed to prevent double delivery."}, {"id": "docs_run_statistics_inferred_floor_vs_confirmed_mode", "label": "Inferred Floor versus Confirmed Mode", "file_type": "rationale", "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Boss dialogue selects the phase layout only; treating the default masterMode false as evidence produced wrong F7 PB announcements after a failed M7 warp. Without exact shared metadata, SYSTEM floor headers or Wither King dialogue, timing continues with PB unavailable and no PB or AVG save."}], "edges": [{"source": "docs_run_statistics_secret_attribution", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_dungeonsecretcounter_dungeonsecretcounter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "weight": 1.0}, {"source": "docs_run_statistics_secret_attribution", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_dungeonsecretcounts_dungeonsecretcounts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "weight": 1.0}, {"source": "docs_run_statistics_summary_roster", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_dungeonrunsummarylayout_dungeonrunsummarylayout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "weight": 1.0}, {"source": "docs_run_statistics_summary_roster", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_dungeondeathtracker_dungeondeathtracker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "weight": 1.0}, {"source": "docs_run_statistics_score_authority", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_dungeonrunstats_dungeonrunstats", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "weight": 1.0}, {"source": "docs_run_statistics_puzzle_penalty", "target": "docs_run_statistics_score_authority", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RUN_STATISTICS.md", "source_location": null, "weight": 1.0},
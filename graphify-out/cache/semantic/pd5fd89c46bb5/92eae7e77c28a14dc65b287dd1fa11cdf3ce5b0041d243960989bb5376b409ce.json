{"nodes": [{"id": "docs_colored_pillars_colored_pillars", "label": "Colored F7 and M7 Pillars", "file_type": "document", "source_file": "docs/COLORED_PILLARS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default-off Dungeon feature recolouring Storm's four diorite columns as Wool, Glass or Terracotta; toggle and material persist in the existing dungeonMap config section."}, {"id": "docs_colored_pillars_pillar_bounds", "label": "Storm Pillar Bounds and Colors", "file_type": "concept", "source_file": "docs/COLORED_PILLARS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four inclusive 7x38x7 columns from Y=169 to Y=206 (Green 46/41, Yellow 46/65, Purple 100/65, Red 100/41); the Y=168 arena floor is excluded and only DIORITE and POLISHED_DIORITE are replaced."}, {"id": "docs_colored_pillars_render_snapshot_contract", "label": "Per-Region Material Snapshot", "file_type": "rationale", "source_file": "docs/COLORED_PILLARS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each RenderSectionRegion or Sodium LevelSlice captures level, instance epoch and material once so mesh workers read an immutable snapshot rather than mutable config; a context change triggers exactly one terrain reload and unchanged context rebuilds nothing."}, {"id": "docs_colored_pillars_boss_dialogue_floor_fallback", "label": "Boss Dialogue Floor Fallback", "file_type": "rationale", "source_file": "docs/COLORED_PILLARS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When structured floor metadata is unknown, original Maxor/Storm/Goldor/Necron dialogue confirms the arena for that instance epoch only; explicit other-floor metadata still wins and the fallback never writes shared floor or master-mode metadata."}, {"id": "docs_colored_pillars_odinlegacy_reference", "label": "OdinLegacy FuckDiorite Reference", "file_type": "concept", "source_file": "docs/COLORED_PILLARS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pinned geometry source; its legacy Blocks.stone check covered all stone variants, so Kung's diorite-only predicate is an inference from that feature's intent."}, {"id": "docs_colored_pillars_sodium_compatibility", "label": "Sodium 0.9.2 Compatibility Target", "file_type": "concept", "source_file": "docs/COLORED_PILLARS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sodium is neither required nor bundled; installed 0.9.2 bytecode confirms its meshing task calls the hooked LevelSlice.getBlockState with world coordinates, so no renderer hook is bypassed."}, {"id": "docs_colored_pillars_no_world_writes", "label": "Render-Only Substitution", "file_type": "rationale", "source_file": "docs/COLORED_PILLARS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both mixins substitute block states only when rendering snapshots are queried; they never write world blocks, change collision or feed replacements into room scans, so server block updates stay authoritative."}], "edges": [{"source": "docs_colored_pillars_colored_pillars", "target": "docs_colored_pillars_pillar_bounds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/COLORED_PILLARS.md", "source_location": null, "weight": 1.0}, {"source": "docs_colored_pillars_colored_pillars", "target": "docs_colored_pillars_render_snapshot_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/COLORED_PILLARS.md", "source_location": null, "weight": 1.0}, {"source": "docs_colored_pillars_colored_pillars", "target": "do
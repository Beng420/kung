{"nodes": [{"id": "docs_catacombs_calculator_fixes_catacombs_calculator", "label": "Catacombs Calculator", "file_type": "document", "source_file": "docs/CATACOMBS_CALCULATOR_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared GUI and chat calculator for C50/CA50 run estimates with selectable Catacombs and per-class targets from 1 to 200."}, {"id": "docs_catacombs_calculator_fixes_profile_selection", "label": "Profile Selection Rule", "file_type": "rationale", "source_file": "docs/CATACOMBS_CALCULATOR_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unselected profile later in the response could overwrite selected=true, and modern responses dropped the old last_save fallback; selection now keeps the explicit flag, otherwise the profile with the most dungeon XP."}, {"id": "docs_catacombs_calculator_fixes_catacombs_explorer", "label": "Catacombs Explorer Bonus", "file_type": "concept", "source_file": "docs/CATACOMBS_CALCULATOR_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each Explorer level adds 0.01 to the Catacombs XP multiplier up to 0.10 at level 10, applied once before the global multiplier and separate from the Catacombs Expert Ring; it does not affect class XP."}, {"id": "docs_catacombs_calculator_fixes_cumulative_shard_conversion", "label": "Cumulative Shard to Level Conversion", "file_type": "rationale", "source_file": "docs/CATACOMBS_CALCULATOR_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "member.attributes.stacks.catacombs_explorer holds cumulative syphoned Bonzo shards, not levels, so a level must be read off the cumulative thresholds rather than clamped to 10 or copied from an incremental table."}, {"id": "docs_catacombs_calculator_fixes_ca50_solver", "label": "CA50 Class Target Solver", "file_type": "concept", "source_file": "docs/CATACOMBS_CALCULATOR_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every class must reach the chosen level and a higher class does not offset a lower one; the solver includes passive class XP at one quarter of selected-class XP, skips completed classes and minimises total runs."}, {"id": "docs_catacombs_calculator_fixes_uitextfield_focus", "label": "Manually Routed Text Field Focus", "file_type": "rationale", "source_file": "docs/CATACOMBS_CALCULATOR_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In 26.1.2 the EditBox click handler positions the cursor but leaves focus to the containing screen, so the calculator's focused-only typing path was unreachable until it explicitly granted keyboard focus after an accepted click."}, {"id": "docs_catacombs_calculator_fixes_adjectils", "label": "Adjectils Dungeon Calculator", "file_type": "concept", "source_file": "docs/CATACOMBS_CALCULATOR_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External reference whose inline formulas, profile selection and maximum accessory/shard presets Kung reproduces exactly, including the 1538/2436 M7 run figures."}, {"id": "docs_catacombs_calculator_fixes_neu_leveling_constants", "label": "NEU Leveling Constants", "file_type": "concept", "source_file": "docs/CATACOMBS_CALCULATOR_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source for the cumulative XP table and the 200,000,000 XP per overflow level above 50."}], "edges": [{"source": "docs_catacombs_calculator_fixes_catacombs_calculator", "target": "docs_catacombs_calculator_fixes_profile_selection", "relation": "references",
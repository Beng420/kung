{"nodes": [{"id": "docs_visitor_alarm_visitor_alarm", "label": "6th Visitor Alarm", "file_type": "concept", "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_visitor_alarm_hidden_sixth_visitor_timer", "label": "Hidden Sixth Visitor Timer", "file_type": "rationale", "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hypixel hides the next-visitor timer once the fifth arrives, so the local timer learns the interval from an arrival while a numeric timer is still visible and carries it forward. Without a usable existing timer it starts a conservative 15-minute interval, which can make the first alarm late."}, {"id": "docs_visitor_alarm_crop_reduction", "label": "Crop-Click Timer Reduction", "file_type": "rationale", "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mature crop clicks advance the hidden prediction by 100 ms per distinct consecutively clicked position, guarded so repeated calls on the same last crop count once. Only hidden timers receive reductions so a visible server countdown is not counted twice."}, {"id": "docs_visitor_alarm_pest_reward_rules", "label": "Pest Reward Counting Rules", "file_type": "rationale", "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single Field Mouse emitted seven reward lines and the old parser subtracted 30 seconds for each, causing a false alarm under four seconds into a 360-second interval. Field Mouse counts only on Dung and Lunar Moth only on Enchanted Sunflower, with no time or name debounce so simultaneous kills of the same pest still count individually."}, {"id": "docs_visitor_alarm_skyhanni_seed", "label": "Optional SkyHanni Timer Seed", "file_type": "rationale", "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At first observation of an already-full queue, read-only SkyHanni storage can seed the known interval and sixth-arrival timestamp. No SkyHanni code or data is bundled, written or required, and missing APIs or sentinel timestamps fall back to local tracking."}, {"id": "docs_visitor_alarm_chat_reminder_replacement", "label": "Replacing Chat Reminder", "file_type": "rationale", "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each reminder replaces the previous owned message and removes it from history and all wrapped display lines so resizing chat cannot bring it back, while unrelated messages with identical text are preserved. It retains a surviving scroll anchor and avoids signed-message deletion notices."}, {"id": "docs_visitor_alarm_offer_click_acknowledgement", "label": "Offer Click Acknowledgement", "file_type": "rationale", "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accept or Refuse clicks silence a ringing alarm in the click handler before local inventory prediction, deliberately also silencing an unsuccessful attempt because no server reply or departure is required. The click itself is neither changed nor cancelled."}], "edges": [{"source": "docs_visitor_alarm_visitor_alarm", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_garden_visitoralarmfeature_visitoralarmfeature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "weight": 1.0}, {"source": "docs_visitor_alarm_hidden_sixth_visitor_timer", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_garden_visitorqueue_visitorqueue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "weight": 1.0}, {"source": "docs_visitor_alarm_hidden_sixth_visitor_timer", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_garden_visitoralarmstate_visitoralarmstate", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "weight": 1.0}, {"source": "docs_visitor_alarm_crop_reduction", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_garden_gardencroptracker_gardencroptracker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "weight": 1.0}, {"source": "docs_visitor_alarm_offer_click_acknowledgement", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_garden_visitoroffer_visitoroffer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "weight": 1.0}, {"source": "docs_visitor_alarm_skyhanni_seed", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_garden_visitortimercompatibility_visitortimercompatibility", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "weight": 1.0}, {"source": "docs_visitor_alarm_chat_reminder_replacement", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_message_kungmessages_kungmessages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/VISITOR_ALARM.md", "source_location": null, "weight": 1.0}, {"source": "docs_visitor_alarm_crop_reduction", "target": "docs_feast_progress
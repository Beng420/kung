{"nodes": [{"id": "docs_development_development_guide", "label": "Development Guide", "file_type": "document", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build, diagnostics, code/comment conventions, optional menu integration and documentation ownership for the active module."}, {"id": "docs_development_build_and_tests", "label": "Java 25 Gradle Build and Focused Tests", "file_type": "concept", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "./gradlew.bat :versions:mc26_1_2:build with the JDK from org.gradle.java.home; a build never installs its JAR and documentation-only changes need no build or version bump."}, {"id": "docs_development_diagnostics", "label": "Trace Ring Buffer Diagnostics", "file_type": "concept", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KungDebugRecorder keeps an in-memory ring saved by /kung log save; full saves keep separate reserves (128 split records, 256 score-calc/score-bonus/mimic-kill, 128 first-nonempty-hash) so map traffic cannot discard early evidence."}, {"id": "docs_development_oneconfig_modmenu_integration", "label": "Optional OneConfig and Mod Menu Integration", "file_type": "concept", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both APIs are compile-only and never bundled; all OneConfig class references sit behind optional-mod checks and KungOneConfigBridge registers native settings and HUD wrappers at CLIENT_STARTED after OneConfig initializes."}, {"id": "docs_development_shared_settings_catalog", "label": "Shared Settings Catalog", "file_type": "rationale", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KungSettings is the single catalog behind both KungConfigScreen and native OneConfig controls so new settings reach the same validated setters from either menu; custom_save stops OneConfig writing a second config file and setters ignore its profile-rebinding pass."}, {"id": "docs_development_menu_scale_and_theme", "label": "80 Percent Menu Scale and Odin-Inspired Theme", "file_type": "concept", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The menu renders at 80% of the selected GUI scale with 171-unit columns; mouse positions are converted once into menu coordinates while Screen.width/height and the global GUI scale stay intact."}, {"id": "docs_development_lowercase_resource_id_rule", "label": "Lowercase Resource ID Rule", "file_type": "rationale", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An uppercase kung:Inter.ttf was an invalid resource ID that rejected the whole kung:menu font including its fallback, producing missing glyph boxes; a single invalid provider ID invalidates the entire font."}, {"id": "docs_development_comment_the_reason", "label": "Comment the Reason, Not the Code", "file_type": "rationale", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comment the reason for a non-obvious rule beside the code that owns it: what invalidates a cache, the units of a clock or geometry, ownership and edge cases, never a narration of method names or a pasted fix history."}, {"id": "docs_development_vscode_gradle_import", "label": "VS Code Gradle Import Workaround", "file_type": "concept", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gradle Build Server can retain an older dependency list after an import failure, so the workspace selects the standard Gradle importer and disables annotation processing around a Gradle 9 parallel-import bug."}, {"id": "docs_development_documentation_ownership", "label": "Documentation Ownership Split", "file_type": "rationale", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AGENTS durable rules, AI_HANDOFF only current status, CODE_MAP ownership and tests, topic docs current contracts, dated reports history; update the existing topic instead of duplicating an explanation, and distinguish a proposed fix, implemented behavior, passing tests and a live result."}, {"id": "docs_development_shared_hud_placement", "label": "Shared HUD Placement Ownership", "file_type": "rationale", "source_file": "docs/DEVELOPMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KungHudLayout supplies the same seven HUD bounds and setters to /kung hud and the OneConfig editor; Kung retains ownsPlacement=true with profile-rebinding guards, and previews never enable a feature or create dungeon/container observations."}], "edges": [{"source": "docs_development_development_guide", "target": "docs_development_build_and_tests", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DEVELOPMENT.md", "source_location": null, "weight": 1.0}, {"source": "docs_development_development_guide", "target": "docs_development_diagnostics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DEVELOPMENT.md", "source_location": null, "weight": 1.0}, {"source": "docs_development_development_guide", "target": "docs_development_o
{"nodes": [{"id": "docs_dungeon_debuffs_dungeon_debuffs", "label": "Dungeon Debuff Observations", "file_type": "document", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ice Spray Highlight and M7 Dragon Debuff are independent default-off features that observe incoming packets and draw local UI; they never use an item, aim, attack or send party chat."}, {"id": "docs_dungeon_debuffs_ice_spray_highlight", "label": "Ice Spray Highlight", "file_type": "concept", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An applied equipment packet giving an invisible armor stand Packed Ice is the effect marker; a matched mob gets an interpolated light-blue box with 20% fill, expiring after 100 accepted server ticks."}, {"id": "docs_dungeon_debuffs_spatial_inference", "label": "Spatial Inference Marker Matching", "file_type": "rationale", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server transmits no target ID, so matching is spatial inference: containment by exactly one box wins, otherwise the nearest unambiguous target within 1.5 blocks (8 for a dragon) and a second candidate within 0.5 blocks makes it unknown rather than marking every nearby mob."}, {"id": "docs_dungeon_debuffs_npc_player_discriminator", "label": "NPC Player Discriminator", "file_type": "concept", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Version-4 UUIDs under Hypixel's NPC convention distinguish NPC miniboss bodies such as Shadow Assassin from real Player accounts; this is a Hypixel convention, not a Minecraft protocol flag."}, {"id": "docs_dungeon_debuffs_interpolation_destination_matching", "label": "Interpolation Destination Matching", "file_type": "rationale", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entity.position() and its current bounds can lag a received movement update, so matching uses InterpolationHandler.position() for both marker and mob and translates the bounding box without changing the entity; distances and the renderer are unchanged."}, {"id": "docs_dungeon_debuffs_m7_dragon_debuff", "label": "M7 Dragon Debuff", "file_type": "concept", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new entity UUID starts a fresh attempt including a same-colour respawn; health-zero packets confirm death while removal only ends the observed timer, and reports publish at the end of the client packet batch after spawn selection settles."}, {"id": "docs_dungeon_debuffs_nearest_statue_selection", "label": "Nearest Statue Selection", "file_type": "concept", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spawns in one server tick plus the following two form a group and the closest horizontal statue to the player's captured first-spawn position is chosen; a bounded heuristic costing at most three nominal ticks of delay, not a server wave ID."}, {"id": "docs_dungeon_debuffs_arrow_feedback_window", "label": "40-Tick Arrow Feedback Window", "file_type": "concept", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Incoming entity.arrow.hit_player sound packets within 0-40 server ticks of spawn and four blocks of the local player count once for the nearest spawning statue; other dragons show '--' rather than a duplicated count or a claimed zero."}, {"id": "docs_dungeon_debuffs_not_lb_only", "label": "Arrow Count Is Not LB-Only", "file_type": "rationale", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The feedback signal carries no target or weapon ID, and a trace confirmed hits received while Terminator was held, so the count must never be labelled source-confirmed, Last-Breath-only or an exact server debuff stack count."}, {"id": "docs_dungeon_debuffs_nofrills_reference", "label": "NoFrills Miniboss Highlight Reference", "file_type": "concept", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inspected source for the NPC-versus-real-player discriminator used by Ice Spray eligibility."}, {"id": "docs_dungeon_debuffs_noamm_dragoncheck_reference", "label": "Noamm DragonCheck Reference", "file_type": "concept", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Packed Ice armor-stand equipment and nearby dragons and assigns shooter feedback to a priority dragon during an early window; Kung instead uses nearest-statue selection and a fixed 40-tick window."}, {"id": "docs_dungeon_debuffs_odin_witherdragonsenum_reference", "label": "Odin WitherDragonsEnum Reference", "file_type": "concept", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-check source for the P5 dragon spawn regions."}, {"id": "docs_dungeon_debuffs_ownership_split", "label": "Debuff Ownership Split", "file_type": "rationale", "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DungeonDebuffFeature takes applied client-thread packet hooks and the shared server-tick event, DungeonDebuffTracker owns bounded in-memory observations, IceSprayHighlightRenderer draws world geometry and DragonDebuffHud draws the HUD, so disabling dragon tracking leaves the independent highlight running."}], "edges": [{"source": "docs_dungeon_debuffs_dungeon_debuffs", "target": "docs_dungeon_debuffs_ice_spray_highlight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "weight": 1.0}, {"source": "docs_dungeon_debuffs_dungeon_debuffs", "target": "docs_dungeon_debuffs_spatial_inference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "weight": 1.0}, {"source": "docs_dungeon_debuffs_dungeon_debuffs", "target": "docs_dungeon_debuffs_npc_player_discriminator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "weight": 1.0}, {"source": "docs_dungeon_debuffs_dungeon_debuffs", "target": "docs_dungeon_debuffs_interpolation_destination_matching", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "weight": 1.0}, {"source": "docs_dungeon_debuffs_dungeon_debuffs", "target": "docs_dungeon_debuffs_m7_dragon_debuff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "weight": 1.0}, {"source": "docs_dungeon_debuffs_dungeon_debuffs", "target": "docs_dungeon_debuffs_nearest_statue_selection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DUNGEON_DEBUFFS.md", "source_location": null, "weight": 1.0}, {"source": "docs_dungeon_d
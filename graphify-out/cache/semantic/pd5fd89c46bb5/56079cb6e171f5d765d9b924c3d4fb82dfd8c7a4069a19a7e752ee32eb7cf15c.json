{"nodes": [{"id": "docs_bow_draw_indicator_bow_draw_indicator", "label": "Bow Draw Indicator", "file_type": "document", "source_file": "docs/BOW_DRAW_INDICATOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default-off Util HUD showing estimated launch power while drawing a normal bow on Hypixel; no trajectory, distance estimate, automatic release or input change."}, {"id": "docs_bow_draw_indicator_bow_power_curve", "label": "Bow Power Curve", "file_type": "concept", "source_file": "docs/BOW_DRAW_INDICATOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses BowItem.getPowerForTime, power = min(1, (t*t + 2*t)/3) with t = drawTicks/20; this is launch strength, not damage percentage."}, {"id": "docs_bow_draw_indicator_server_tick_only_charge", "label": "Server-Tick-Only Charge Accumulation", "file_type": "rationale", "source_file": "docs/BOW_DRAW_INDICATOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client frames, client ticks and wall time never add charge because at 10 TPS a full draw takes about two seconds and a server stall must stop progress; no smoothed TPS extrapolation runs ahead of a stall."}, {"id": "docs_bow_draw_indicator_last_draw_hold", "label": "Last Draw 200 ms Hold", "file_type": "rationale", "source_file": "docs/BOW_DRAW_INDICATOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Release holds the final value for 200 ms so a draw shorter than one rendered frame stays visible and rapid shots do not flash; only display persistence uses wall time."}, {"id": "docs_bow_draw_indicator_draw_thresholds", "label": "Configurable Draw Thresholds", "file_type": "concept", "source_file": "docs/BOW_DRAW_INDICATOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default markers are the gameplay boundaries 3t (minimum 0.1 power needed to fire) and 20t (full power); the former 13t/18t defaults were only visual model stages, not ballistic breakpoints."}, {"id": "docs_bow_draw_indicator_stack_identity_tolerance", "label": "Inventory Stack Replacement Tolerance", "file_type": "rationale", "source_file": "docs/BOW_DRAW_INDICATOR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reference equality on the held stack is not a cancellation signal: an inventory packet replacing the same bow retains charge, matching vanilla updatingUsingItem; switching to a shortbow still invalidates it."}], "edges": [{"source": "docs_bow_draw_indicator_bow_draw_indicator", "target": "docs_bow_draw_indicator_bow_power_curve", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BOW_DRAW_INDICATOR.md", "source_location": null, "weight": 1.0}, {"source": "docs_bow_draw_indicator_bow_draw_indicator", "target": "docs_bow_draw_indicator_server_tick_only_charge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BOW_DRAW_INDICATOR.md", "source_location": null, "weight": 1.0}, {"source": "docs_bow_draw_indicator_bow_draw_indicator", "target": "docs_bow_draw_indicator_last_draw_hold", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BOW_DRAW_INDICATOR.md", "source_location": null, "weight": 1.0}, {"source": "docs_bow_draw_indicator_bow_draw_indicator", "target": "docs_bow_draw_indicator_draw_thresholds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BOW_DRAW_INDICATOR.md", "source_location": null, "weight": 1.0}, {"source": "docs_bow_draw_indicator_bow_draw_indicator", "target": "docs_bow_draw_indicator_stack_identity_tolerance", "
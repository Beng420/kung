{"nodes": [{"id": "docs_updates_update_notification", "label": "Update Availability Notification", "file_type": "rationale", "source_file": "docs/UPDATES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 30-second client-tick poll shares one interval with menu and join requests instead of creating extra requests, pausing during a download or pending restart. After a card ends, a five-minute cooldown gates the next lobby or world change so polling the same release alone cannot repeat it."}, {"id": "docs_updates_update_toast_card", "label": "Update Toast Card", "file_type": "concept", "source_file": "docs/UPDATES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_updates_hypixel_hostname_matching", "label": "Hypixel Hostname Matching", "file_type": "rationale", "source_file": "docs/UPDATES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matching uses the server address hostname, accepting hypixel.net or a subdomain with optional port, case differences or trailing dot, while lookalikes such as nothypixel.net and hypixel.net.example.com are rejected along with custom aliases and direct IPs."}, {"id": "docs_updates_verified_post_exit_installation", "label": "Verified Post-Exit Installation", "file_type": "rationale", "source_file": "docs/UPDATES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the loaded standalone JAR inside this profile's mods can be replaced, after byte count, SHA-256, ZIP entry and Fabric dependency verification. A JDK-only helper waits for the exact game PID to exit and its only commit is an atomic replacement, with no delete-first or copy-over-active-JAR fallback."}, {"id": "docs_updates_pending_transaction_marker", "label": "Pending Transaction Marker", "file_type": "rationale", "source_file": "docs/UPDATES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The transaction records old and new SHA-256 values and exact paths through a flushed temporary file and atomic marker publication. Unverified legacy or malformed markers are preserved as rejected files and never executed, and a changed installed JAR cancels stale recovery rather than downgrading it."}, {"id": "docs_updates_launcher_ownership", "label": "Launcher Ownership Guard Removal", "file_type": "rationale", "source_file": "docs/UPDATES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The blanket launcher guard was too broad: the installed Modrinth release rescans changed hashes at the same path and its launch path lacks the shared-store validation used to justify the guard. Launcher identity alone therefore never rejects a pending update, and the earlier repair wording came from a different development revision."}, {"id": "docs_updates_release_notes_modal", "label": "Release Notes Modal", "file_type": "rationale", "source_file": "docs/UPDATES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Notes are fetched for the exact installed tag, first with a v prefix then without, and the latest release's notes are never substituted. Only the first actual rendering acknowledges the version, while explicit closing stores a separate dismissal, because dismissal does not claim the notes were read."}, {"id": "docs_updates_release_history_sidebar", "label": "Release History Sidebar", "file_type": "rationale", "source_file": "docs/UPDATES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the visible sidebar page is requested, with bounded caches of four list pages and eight note bodies, no startup work, body prefetching or disk writes. Requests always use Kung's own GitHub endpoint rather than an arbitrary Link URL, and reading historical notes cannot overwrite the installed-version receipt."}], "edges": [{"source": "docs_updates_update_notification", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_update_kungupdatenotification_kungupdatenotification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/UPDATES.md", "source_location": null, "weight": 1.0}, {"source": "docs_updates_update_notification", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_update_kungupdatecheckschedule_kungupdatecheckschedule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/UPDATES.md", "source_location": null, "weight": 1.0}, {"source": "docs_updates_update_notification", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_update_kungupdater_kungupdater", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/UPDATES.md", "source_location": null, "weight": 1.0}, {"source": "docs_updates_update_toast_card", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_update_kungupdatetoast_kungupdatetoast", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/UPDATES.md", "source_location": null, "weight": 1.0}, {"source": "docs_updates_update_toast_card", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_update_kungupdatetoaststate_kungupdatetoaststate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/UPDATES.md", "source_location": null, "weight": 1.0}, {"source": "docs_updates_hypixel_hostname_matching", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_update_kungupdatenotification_kungupdatenotification", "relation": "references", "conf
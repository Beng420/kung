{"nodes": [{"id": "docs_mimic_static_chests_static_trapped_chest_catalog", "label": "Static Trapped Chest Catalog", "file_type": "concept", "source_file": "docs/MIMIC_STATIC_CHESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mimic_static_chests_rotation_matching", "label": "Four-Rotation Template Matching", "file_type": "rationale", "source_file": "docs/MIMIC_STATIC_CHESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rotation uses the actual built extent rather than the player's view direction, and templates carry 12 to 48 independent structure blocks that provably distinguish alternative rotations. Chests, air and redstone are excluded as landmarks because they are dynamic."}, {"id": "docs_mimic_static_chests_ambiguity_guard", "label": "Ambiguous Rotation Guard", "file_type": "rationale", "source_file": "docs/MIMIC_STATIC_CHESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An exclusion applies only to a position that is static under every still-possible rotation, never to the union of possible chest positions, because blocking the union could hide a real Mimic. Missing chunks keep other rotations open and an ambiguous first capture is rejected without saving data."}, {"id": "docs_mimic_static_chests_incremental_chest_scan", "label": "Incremental Block-Entity Chest Scan", "file_type": "rationale", "source_file": "docs/MIMIC_STATIC_CHESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The scan reads the full block-entity position index of loaded chunks including uninitialized entries, bounded to nearby chunks, four chunk checks per tick and a cooperative 2 ms budget with at most one full chunk fallback. Chunks are never force-loaded and no block queries happen in the render path."}, {"id": "docs_mimic_static_chests_mimic_esp_waypoint", "label": "Mimic ESP Waypoint and Map Marker", "file_type": "rationale", "source_file": "docs/MIMIC_STATIC_CHESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since 0.3.3 only the 2D waypoint and map marker remain; the red 3D box was removed without changing detection, chest exclusions or kill capture. The waypoint is deliberately invisible outside the same room while the map can still mark the recognized room."}, {"id": "docs_mimic_static_chests_session_capture", "label": "Session Chest Capture Commands", "file_type": "rationale", "source_file": "docs/MIMIC_STATIC_CHESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit captures live only until the next restart and are copied to the clipboard for later bundling; nothing is written to a profile file or uploaded, and undo cannot remove the built-in exclusions."}, {"id": "docs_mimic_static_chests_stellas_rooms_json", "label": "Stella rooms.json Chest List", "file_type": "document", "source_file": "docs/MIMIC_STATIC_CHESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_mimic_static_chests_static_trapped_chest_catalog", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_dungeonstaticchestcatalog_dungeonstaticchestcatalog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/MIMIC_STATIC_CHESTS.md", "source_location": null, "weight": 1.0}, {"source": "docs_mimic_static_chests_rotation_matching", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_dungeonstaticchestpattern_dungeonstaticchestpattern", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/MIM
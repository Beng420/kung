{"nodes": [{"id": "docs_feast_progress_feast_progress", "label": "Feast Progress", "file_type": "concept", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_feast_progress_harvest_feast", "label": "Harvest Feast", "file_type": "concept", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_feast_progress_grand_feast", "label": "Grand Feast", "file_type": "concept", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_feast_progress_kernel_rate_estimate", "label": "Kernel Rate Estimate", "file_type": "rationale", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each completed five-minute farming block contributes 20% and the saved estimate retains 80%, so the value changes only at block boundaries. Chosen because the earlier decay method jumped between 30 and 90/h on individual drops; full floating-point precision is kept and only the HUD rounds."}, {"id": "docs_feast_progress_kernel_timeout", "label": "Kernel Timeout Setting", "file_type": "rationale", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seconds field clamped to 10-300 with a 60-second default so a 20-second pest hunt keeps the farming clock running. The timeout grace counts as farming time but later idle time is excluded, so long gaps cannot slip into the denominator."}, {"id": "docs_feast_progress_milestone_bar", "label": "Milestone Progress Bar", "file_type": "concept", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_feast_progress_kernel_balance", "label": "Kernel Balance", "file_type": "rationale", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read only from exact server sidebar rows or menu lore plus confirmed Ted gains; another mod's cached balance is never used as a baseline because it can be stale. A missing baseline stays unknown rather than being displayed as a made-up zero."}, {"id": "docs_feast_progress_milestone_claim_confirmation", "label": "Milestone Claim Confirmation", "file_type": "rationale", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A click alone does not add currency: within 15 seconds a server slot packet must show the same completed tier without glint or claim prompt. Each tier credits once per Feast so duplicate clicks and menu reopens cannot double-count."}, {"id": "docs_feast_progress_profile_identity", "label": "Account and Profile Cache Identity", "file_type": "rationale", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache is keyed by player account UUID plus normalized SkyBlock profile name, with the server Profile ID invalidating a deleted and recreated profile of the same fruit name. Repeated join notices must not reset anything because ordinary joins were discarding the baseline."}, {"id": "docs_feast_progress_allow_game_observation", "label": "ALLOW_GAME Pre-filter Message Observation", "file_type": "rationale", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Observation uses Fabric ALLOW_GAME always returning true so all listeners run even if another filter rejects the message, and observation precedes MODIFY_GAME. No second listener on GAME or GAME_CANCELED, so one server event is counted exactly once."}, {"id": "docs_feast_progress_seasoning_donation", "label": "Seasoning Donation Message", "file_type": "concept", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_feast_progress_feast_progress_json", "label": "feast-progress.json State File", "file_type": "concept", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_feast_progress_skyhanni_currencyapi", "label": "SkyHanni CurrencyApi", "file_type": "document", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_feast_progress_skyblock_api_currencyapi", "label": "SkyBlock API CurrencyAPI", "file_type": "document", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_feast_progress_hypixel_election_endpoint", "label": "Hypixel Public Election Endpoint", "file_type": "document", "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_feast_progress_feast_progress", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_garden_feastoverlayfeature_feastoverlayfeature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FEAST_PROGRESS.md", "source_location": null, "weight": 1.0}, {"source": "docs_feast_progress_kernel_rate_estimate", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_garden_feastkernelrate_feastkernelrate", "relation": "references
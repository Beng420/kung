{"nodes": [{"id": "docs_splits_timing_fixes_mort_start_alignment", "label": "Mort Start Alignment Evidence", "file_type": "rationale", "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A captured trace measured 1,119 real ms and 21 accepted ticks between countdown and Mort's greeting, which supersedes the retained countdown-origin policy. The server banner's whole-second precision cannot supply an exact millisecond finish, so the rebase uses the observed offset rather than a constant."}, {"id": "docs_splits_timing_fixes_bundle_ping_classification", "label": "Bundle Ping Source Classification", "file_type": "rationale", "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundle expansion had treated every non-zero child ping as a game tick and consecutive-ID deduplication could not help because the IDs were distinct, so pings arriving after a slowdown erased loss. Both consumers now reject bundle pings before deduplication while a handleBundlePacket wrapper preserves child-packet provenance and applied chat order."}, {"id": "docs_splits_timing_fixes_tick_clipping_removal", "label": "Removal of Arrival-Time Tick Caps", "file_type": "rationale", "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The per-tick cap truncated fractions of legitimate ticks whenever nominal tick time briefly led real time and discarded delayed ticks around short dialogue phases, losing 1,659 ms in one measured run. Removing invalid packet sources and conserving valid ticks is sufficient, with no constant offset or redistribution across phases."}, {"id": "docs_splits_timing_fixes_zero_ping_filter", "label": "Zero Ping Sequence Filter", "file_type": "rationale", "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepting ping ID zero as both a tick and a deduplication baseline made a -10, 0, -10 sequence count three ticks instead of one. The shared sequence now ignores zero before updating its last real ID, following Odin's non-zero packet filter, and never infers ticks from numeric ID gaps."}, {"id": "docs_splits_timing_fixes_ideal_clock_estimate", "label": "Packet-Based Ideal Clock Estimate", "file_type": "rationale", "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time Lost remains real duration minus observed server duration and cannot by itself separate a server slowdown from network or client delay at a boundary, so no specific TPS drop is claimed without clock and packet evidence. A monotonic clock prevents computer clock corrections from creating lost time."}], "edges": [{"source": "docs_splits_timing_fixes_bundle_ping_classification", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_util_servertpstracker_servertpstracker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "weight": 1.0}, {"source": "docs_splits_timing_fixes_zero_ping_filter", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_util_serverticksequence_serverticksequence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "weight": 1.0}, {"source": "docs_splits_timing_fixes_bundle_ping_classification", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_util_servertickpacketcontext_servertickpacketcontext", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "weight": 1.0}, {"source": "docs_splits_timing_fixes_tick_clipping_removal", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_dungeonsplittracker_dungeonsplittracker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "weight": 1.0}, {"source": "docs_splits_timing_fixes_bundle_ping_classification", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_dungeonservertickevents_dungeonservertickevents", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "weight": 1.0}, {"source": "docs_splits_timing_fixes_zero_ping_filter", "target": "docs_splits_timing_fixes_bundle_ping_classification", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "weight": 1.0}, {"source": "docs_splits_timing_fixes_tick_clipping_removal", "target": "docs_splits_timing_fixes_ideal_clock_estimate", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "weight": 1.0}, {"source": "docs_splits_timing_fixes_mort_start_alignment", "target": "docs_run_statistics_mort_start_rebase", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "weight": 1.0}, {"source": "docs_splits_timing_fixes_bundle_ping_classification", "target": "docs_run_statistics_standalone_ping_tick_source", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "weight": 1.0}, {"source": "docs_splits_timing_fixes_ideal_clock_estimate", "target": "docs_superpairs_fixes_unseen_pairs_bound", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/SPLITS_TIMING_FIXES.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "split_clock_tick_pipeline", "label": "Split Clock Tick Accounting Pipeline", "nodes": ["docs_run_statistics_standalone_ping_tick_source", "docs_run_statistics_time_lost", "docs_splits_timing_fixes_bundle_ping_classification", "docs_splits_timing_fixes_zero_ping_filter", "docs_splits_timing_fixes_tick_clipping_removal", "docs_splits_timing_fixes_ideal_clock_estimate"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SPLITS_TIMING_FIXES.md"}]}
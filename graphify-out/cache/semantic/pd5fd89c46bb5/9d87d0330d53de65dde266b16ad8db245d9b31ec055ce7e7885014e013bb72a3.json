{"nodes": [{"id": "docs_foundation_todo_demand_driven_runtime", "label": "Demand-Driven Runtime", "file_type": "rationale", "source_file": "docs/FOUNDATION_TODO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lightweight context tracking is separated from feature-specific dungeon processing so instance, party and dungeon lifecycle stay available while individual features are disabled, and all world scanning stops when no enabled feature requires it."}, {"id": "docs_foundation_todo_runtime_capability", "label": "Explicit Runtime Capabilities", "file_type": "concept", "source_file": "docs/FOUNDATION_TODO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_foundation_todo_hot_activation", "label": "Mid-Run Hot Activation", "file_type": "rationale", "source_file": "docs/FOUNDATION_TODO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enabling the Dungeon Map after joining must rebuild current state from the world, map item, lifecycle context and tracked party members; historical scans must not be required because the first scan has to produce a usable snapshot."}, {"id": "docs_foundation_todo_app_services", "label": "AppServices Runtime Object", "file_type": "rationale", "source_file": "docs/FOUNDATION_TODO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small runtime object carries config, messages and shared trackers, passed explicitly to new features instead of adding more global lookups, with long-lived services and user-facing features in separate registries."}, {"id": "docs_foundation_todo_shared_presentation", "label": "Shared Presentation Primitives", "file_type": "rationale", "source_file": "docs/FOUNDATION_TODO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One central message builder with INFO, SUCCESS, WARNING, ERROR and DEBUG styles plus shared UiTheme, UiBounds and reusable controls, so screens and overlays share text, field, spacing and color primitives and local mod messages stay separate from outgoing Hypixel chat."}, {"id": "docs_foundation_todo_wish_reminder", "label": "Wish Reminder", "file_type": "concept", "source_file": "docs/FOUNDATION_TODO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_foundation_todo_blood_rush_helper", "label": "Blood Rush Helper Reliability", "file_type": "rationale", "source_file": "docs/FOUNDATION_TODO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scanned Wither and Blood door block transitions are the authoritative trigger, and the plus suffix stays while only a lower bound is known; it is dropped only with an uninterrupted recognized Start-to-Blood path, because matching door totals alone are not proof."}], "edges": [{"source": "docs_foundation_todo_demand_driven_runtime", "target": "docs_foundation_todo_runtime_capability", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FOUNDATION_TODO.md", "source_location": null, "weight": 1.0}, {"source": "docs_foundation_todo_hot_activation", "target": "docs_foundation_todo_demand_driven_runtime", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/FOUNDATION_TODO.md", "source_location": null, "weight": 1.0}, {"source": "docs_foundation_todo_app_services", "target": "docs_foundation_todo_demand_driven_runtime", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/FOUNDATION_TODO.md", "source_location": null, "weight": 1.0}, {"source": "docs_foundation_todo_demand_d
{"nodes": [{"id": "docs_dungeon_fixes_dungeon_fixes", "label": "Dungeon Performance and Feature Fixes", "file_type": "document", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dated 2026-09-11 investigation of dungeon performance, recognition, instance detection, splits and statistics; its build counts describe that change set at that time."}, {"id": "docs_dungeon_fixes_prince_icon_hot_path", "label": "Prince Icon Per-Frame Hot Path", "file_type": "rationale", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hasPrince ran for every labelled room every frame, hitting the profile database file and normalising names with regular expressions; an isolated 24-room workload measured about 6.6 ms/frame before and 0.01 ms after, so rendering now reads the flag off the already matched room."}, {"id": "docs_dungeon_fixes_incremental_mimic_discovery", "label": "Incremental Mimic Discovery", "file_type": "concept", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nearby block entities are checked promptly, the grid is traversed incrementally and at most one full chunk fallback runs per tick; unloaded chunks and empty visible results no longer remove the map mark or count as a kill."}, {"id": "docs_dungeon_fixes_instance_detection", "label": "Packet-Applied Instance Detection", "file_type": "concept", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HypixelInstanceTracker consumes applied sidebar, team, objective, tab and player-info packets at TAIL; membership no longer depends on map possession, grid coordinates, waiting periods or an earlier countdown."}, {"id": "docs_dungeon_fixes_sidebar_coalescing", "label": "End-of-Tick Sidebar Coalescing", "file_type": "rationale", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-packet sidebar reads falsely ended an F1 run when server m61e briefly read m61 between updates, so updates coalesce at the end of the client tick and an intermediate prefix/suffix rewrite cannot create a server change inside one packet batch."}, {"id": "docs_dungeon_fixes_rare_room_type", "label": "RARE Room Type Migration", "file_type": "concept", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A blue RARE type applied to matched Rare names changes only types while hashes and other metadata stay intact; the Lava Pit migration was reverted because duplicate wiki names do not establish hash identity."}, {"id": "docs_dungeon_fixes_m7_split_progression", "label": "M7 Split Phase Progression", "file_type": "concept", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maxor, Storm, Terminals, Goldor, Necron, Relics, Wither King dialogue and Dragons follow the three clear splits; Necron's death starts Relics and the victory dialogue completes Dragons, with no separate Victory phase."}, {"id": "docs_dungeon_fixes_layers_connected_rendering", "label": "Layers Connected-Room Rendering", "file_type": "concept", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A scanned-OPEN separator let catalog matching split Layers into one cell plus a two-cell column, so DungeonRoomRenderLayout now supplies one shared projection for fills, connections and labels from final ownership and internal connections."}, {"id": "docs_dungeon_fixes_secret_source_priority", "label": "Secret Source Priority", "file_type": "concept", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Personal integer Secrets Found fields belong to the local player regardless of preceding party rows; DungeonSecretCounter prefers personal tab, then verified remote self-report, then valid API deltas, and missing personal values display '?'."}, {"id": "docs_dungeon_fixes_death_attribution", "label": "Death Attribution Guard", "file_type": "rationale", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A broad regex captured a forwarded Skyblocker death message in party chat and registered a false death, so only actual system death lines for known players are accepted and reconciled against exact Team Deaths fields."}, {"id": "docs_dungeon_fixes_map_text_scale", "label": "Independent Map and Text Scale", "file_type": "concept", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The hidden screen-size clamp was removed so the saved 25-300% map scale applies consistently; a separate 50-200% Text Scale covers names, secrets, '?' markers, debug labels, Prince glyphs, footer and legend including their measured bounds."}, {"id": "docs_dungeon_fixes_odin_splits_reference", "label": "Odin Splits HUD Reference", "file_type": "concept", "source_file": "docs/DUNGEON_FIXES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design and floor boundaries were checked against Odin's Splits HUD, SplitsManager and KingRelics, which treats Necron's death line as the Relics boundary."}], "edges": [{"source": "docs_dungeon_fixes_du
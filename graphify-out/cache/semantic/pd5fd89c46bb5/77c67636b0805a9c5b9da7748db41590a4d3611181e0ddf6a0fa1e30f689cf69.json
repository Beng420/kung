{"nodes": [{"id": "docs_file_storage_runtime_file_layout", "label": "Runtime File Storage Layout", "file_type": "concept", "source_file": "docs/FILE_STORAGE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_file_storage_profile_migration", "label": "Startup Profile Directory Migration", "file_type": "rationale", "source_file": "docs/FILE_STORAGE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old profile-root directories relocate under config/kung before config, services and features load. Identical duplicates are removed after byte comparison while differing duplicates are preserved under config/kung/legacy, because silently overwriting a differing file would lose data; symlinks are preserved rather than followed."}, {"id": "docs_file_storage_atomic_sibling_replacement", "label": "Atomic Temporary-Sibling File Replacement", "file_type": "rationale", "source_file": "docs/FILE_STORAGE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kung-owned writes replace the target through a flushed temporary sibling so an interrupted write cannot leave a truncated config, cache or marker behind."}, {"id": "docs_file_storage_dungeon_data_directory", "label": "config/kung/dungeon-data Directory", "file_type": "concept", "source_file": "docs/FILE_STORAGE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_file_storage_oneconfig_custom_save", "label": "OneConfig custom_save Hook", "file_type": "rationale", "source_file": "docs/FILE_STORAGE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native OneConfig settings reuse Kung's own config and validated setters, and the custom_save hook prevents OneConfig from loading or writing a
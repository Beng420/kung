{"nodes": [{"id": "docs_m7_dragons_m7_dragon_helper", "label": "M7 Dragon Helper", "file_type": "concept", "source_file": "docs/M7_DRAGONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_m7_dragons_spawn_markers", "label": "Dragon Spawn Markers", "file_type": "concept", "source_file": "docs/M7_DRAGONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_m7_dragons_statue_boxes", "label": "Estimated Statue Boxes", "file_type": "rationale", "source_file": "docs/M7_DRAGONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gray, green and red outlines describe a geometric estimate of 13.5 blocks in X/Z and Y 6 to 29.5, not a live server verdict. The check uses the dragon's received origin rather than its large interpolated body box, because Skytils community estimates are not documented exact server boxes."}, {"id": "docs_m7_dragons_count_confirmation", "label": "Dragon Count Confirmation", "file_type": "rationale", "source_file": "docs/M7_DRAGONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A count is reported only after server evidence: an observed statue block turning to air or an exact Wither King line. A death without confirmation after 40 ticks is reported as unknown rather than a failed count, because an unload is not a death and a respawn does not prove failure."}, {"id": "docs_m7_dragons_spawn_identity", "label": "Dragon Spawn Identity", "file_type": "rationale", "source_file": "docs/M7_DRAGONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identity requires the original spawn observation within four blocks of exactly one known spawn; an unidentified dragon stays unassigned rather than being guessed from its later position, which is why the feature must be enabled before dragons spawn."}, {"id": "docs_m7_dragons_developer_access_gate", "label": "Developer Account Access Gate", "file_type": "rationale", "source_file": "docs/M7_DRAGONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The whole helper and its tools are restricted to one verified local Minecraft User profile UUID; names, tab entries and server-provided UUIDs do not grant access and a copied enabled config cannot activate it. The initial implementation gated only diagnostics, which a reported visible menu entry exposed as a scope mismatch."}, {"id": "docs_m7_dragons_odin_dragon_table", "label": "Odin WitherDragonsEnum Coordinate Table", "file_type": "document", "source_file": "docs/M7_DRAGONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_m7_dragons_skytils_m7_implementation", "label": "Skytils MasterMode7Features Range Reference", "file_type": "document", "source_file": "docs/M7_DRAGONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_m7_dragons_wither_king_dialogue", "label": "Wither King Dialogue Evidence", "file_type": "concept", "source_file": "docs/M7_DRAGONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_m7_dragons_m7_dragon_helper", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_m7dragonfeature_m7dragonfeature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/M7_DRAGONS.md", "source_location": null, "weight": 1.0}, {"source": "docs_m7_dragons_count_confirmation", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_dungeon_m7dragontracker_m7dragontracker", "relation": "references"
{"nodes": [{"id": "docs_dungeon_architecture_dungeon_architecture", "label": "Dungeon Architecture", "file_type": "document", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current dungeon contracts extracted from the handoff on 2026-09-12: lifecycle, map pipeline, markers, Blood Rush and Mimic lifetime."}, {"id": "docs_dungeon_architecture_instance_and_run_lifecycle", "label": "Instance and Run Lifecycle", "file_type": "concept", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HypixelInstanceTracker is the shared location authority; applied packet hooks run at TAIL on the client thread and sidebar/team/score changes are coalesced at end of tick because Hypixel can rebuild a row as m61e -> m61 -> m61e during an F1 boss teleport."}, {"id": "docs_dungeon_architecture_map_pipeline_and_budgets", "label": "Map Pipeline and Budgets", "file_type": "concept", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DungeonScanRecorder -> DungeonMapSnapshot -> DungeonRoomRepository / DungeonKnownRoomCatalog -> DungeonLiveMapWriter.MatchRenderPlan -> DungeonRoomRenderLayout -> DungeonMapFeature."}, {"id": "docs_dungeon_architecture_scan_budget", "label": "Bounded Cooperative Scan Budget", "file_type": "rationale", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scans run in bounded batches on a cooperative 2 ms budget with locked-door checks every two ticks, kept separate from rendering; recurring full-grid scans, per-frame file reads and catalogue normalization must never be restored."}, {"id": "docs_dungeon_architecture_matching_revision_cache", "label": "Matching Revision Cache Invalidation", "file_type": "rationale", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalogue matches cache separately from visit/checkmark changes: a stable-hash change, new map visibility/connectors or a full-world-cell observation advances the matching revision, while repeated observations and player/checkmark changes do not."}, {"id": "docs_dungeon_architecture_room_owner_union", "label": "Logical Room Owner Union", "file_type": "concept", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The renderer draws logical roomOwners joined by internalDoors rather than each raw match, keeping rooms like Layers connected; render-only merges are never persisted as catalogue matches or used for learning."}, {"id": "docs_dungeon_architecture_four_cell_limit", "label": "Four-Cell Owner Limit", "file_type": "rationale", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both owner-union passes enforce a four-cell limit before expanding visited/cleared/completed state, because merging two catalog matches into a five-cell owner split Bridges into five labels and shared completion across unrelated rooms."}, {"id": "docs_dungeon_architecture_room_prediction", "label": "Render-Only Room Prediction", "file_type": "concept", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At least two exact cell hashes may imply every remaining unseen cell only when all compatible template rotations and mirrors leave one footprint; predicted cells never enter scan points, learning matches, logical owners, score/clear credit or live room sync."}, {"id": "docs_dungeon_architecture_player_markers", "label": "Player Markers", "file_type": "concept", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed five-slot roster from identified tab/class rows and self, with the local player at slot 0 / FRAME and BLUE_MARKER decorations mapping sequentially to slots 1-4; missing identity means skip and trace, never guess from nearby entities or ranks."}, {"id": "docs_dungeon_architecture_blood_rush", "label": "Blood Rush Lower-Bound Door Estimate", "file_type": "concept", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Until an uninterrupted recognized START-to-BLOOD path is supported by map visibility or physical scans, report an observed lower bound with '+' and never substitute a magic fallback count; equal raw/path totals alone do not establish an exact count."}, {"id": "docs_dungeon_architecture_late_door_scans", "label": "Late Door Scans After Blood Opened", "file_type": "concept", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "observeProgress checked completion only in its zero-remaining branch, so positive counts still emitted titles after bloodRushDoneShown was set; the completion guard now covers the whole automatic progress path using the already confirmed server event rather than a larger scan budget."}, {"id": "docs_dungeon_architecture_mimic_lifetime", "label": "Mimic Lifetime Memory", "file_type": "concept", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DungeonMimicChestMemory retains room evidence across distance and chunk unloads; an empty loaded scan does not prove a kill, and only conflicting evidence, reclassification, a confirmed kill, map reset, disable or instance exit may clear it."}, {"id": "docs_dungeon_architecture_mort_start_rebase", "label": "Mort Greeting Split Clock Rebase", "file_type": "concept", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mort's exact map-greeting confirms the playable start and rebases both split clocks once, excluding the countdown; missing Mort keeps the countdown fallback and duplicate or late greetings cannot rewrite completed phases."}, {"id": "docs_dungeon_architecture_allow_game_observation", "label": "ALLOW_GAME Pre-Filter Observation", "file_type": "rationale", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dungeon messages are observed once through Fabric's ALLOW_GAME / ALLOW_CHAT before display cancellation or modification, so Kung's own chat filter only controls visibility and can no longer lose hidden or modified bonus messages by forwarding them separately."}, {"id": "docs_dungeon_architecture_completion_idempotence", "label": "Idempotent Completion Signals", "file_type": "rationale", "source_file": "docs/DUNGEON_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Team Score may precede the Defeated banner, so completion signals are idempotent and splits freeze at the first one while retaining the final-phase sample for five seconds to let a matching victory confirm its PB without moving a clock."}], "edges": [{"source": "docs_dungeon_architecture_dungeon_architecture", "target": "docs_dungeon_architecture_instance_and_run_lifecycle", "relation": "references", "confidence": "EXTRACTED", "c
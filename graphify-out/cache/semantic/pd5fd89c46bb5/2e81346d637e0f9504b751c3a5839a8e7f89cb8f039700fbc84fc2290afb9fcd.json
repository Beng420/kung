{"nodes": [{"id": "agents_kung_contributor_guide", "label": "Kung Contributor Guide", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_passive_client_qol_invariant", "label": "Passive Client QoL Invariant", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Features stay passive client-side QoL with English player-visible text; feature master toggles default off so a fresh install never becomes active without the user enabling it."}, {"id": "agents_bounded_dungeon_scans_invariant", "label": "Bounded Scans and Packet-Confirmed Instance State", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dungeon work must preserve bounded scans, cached matching and packet-confirmed instance state; unbounded per-frame scans previously cost measurable frame time."}, {"id": "agents_profile_data_separation", "label": "Profile Data Separation from Bundled Data", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal builds must not sync learned rooms or install a JAR into a game profile as a side effect, so a build never mutates the user's live game."}, {"id": "agents_runtime_file_containment", "label": "Runtime File Containment", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime files belong under config/kung or logs/kung via KungPaths, apart from the mod JAR, so the mod cannot scatter writes across the profile."}, {"id": "agents_active_module_mc26_1_2", "label": "Active Module 
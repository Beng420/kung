{"nodes": [{"id": "docs_lobby_hop_helper_lobby_hop_helper", "label": "Lobby Hop Helper", "file_type": "concept", "source_file": "docs/LOBBY_HOP_HELPER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lobby_hop_helper_last_presence_timestamp", "label": "Last-Presence Timestamp", "file_type": "rationale", "source_file": "docs/LOBBY_HOP_HELPER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The monotonic timestamp refreshes on every valid tick in the current lobby, so elapsed time measures time since the last observed presence rather than since the previous arrival; both the subtitle and chat line use the same snapshot."}, {"id": "docs_lobby_hop_helper_capacity_eviction", "label": "Lobby History Capacity Eviction", "file_type": "rationale", "source_file": "docs/LOBBY_HOP_HELPER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "History is bounded to 128 remembered lobby IDs in memory, evicting the oldest by first-insertion order; turning the feature off clears it and a restart starts fresh, so nothing is persisted."}], "edges": [{"source": "docs_lobby_hop_helper_lobby_hop_helper", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_feature_misc_lobbyhophelperfeature_lobbyhophelperfeature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LOBBY_HOP_HELPER.md", "source_location": null, "weight": 1.0}, {"source": "docs_lobby_hop_helper_lobby_hop_helper", "target": "versions_mc26_1_2_src_main_java_com_github_beng420_kung_skyblock_hypixelinstancetracker_hypixelinstancetracker", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LOBBY_HOP_HELPER.md", "source_location": null, "weight": 1.0}, {"source": "docs_lobby_hop_helper_last_presence_timest
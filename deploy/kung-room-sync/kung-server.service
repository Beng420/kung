[Unit]
Description=Kung room sync server
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=kung-server
EnvironmentFile=/etc/kung-server.env
ExecStart=/usr/bin/node /opt/kung-server/kung-room-sync-server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

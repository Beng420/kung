.gradle/
build/
out/
/versions/*/bin/
run/
runs/
*.log
*.class
*.jar
*.zip

.idea/
*.iml
.vscode/

!.github/

# graphify: generated outputs are rebuilt by `graphify update` in ~35s for free.
# The semantic cache is the exception — it cost real LLM tokens, so it is kept
# so a fresh clone replays the doc extraction instead of paying for it again.
graphify-out/*
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/semantic/

# Local only: agent notes, docs, Codex scratch folders and the libs shortcut.
.editorconfig
.graphifyignore
AGENTS.md
CLAUDE.md
docs/
.codex/
.codex-video-frames/
.codex_tmp/
*.lnk
.agents/
.claude/
